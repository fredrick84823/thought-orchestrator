# GitHub 連動設定
# 複製此檔案為 .env.local 並填入你的值

# GitHub Personal Access Token
# 建立方式：GitHub → Settings → Developer settings → Personal access tokens → Fine-grained tokens
# 所需權限：Contents (Read-only) → 選擇 fredrick84823/thoughts repo
GITHUB_TOKEN=ghp_your_token_here

# thoughts repo 資訊（預設值已填好，通常不需要修改）
GITHUB_REPO_OWNER=fredrick84823
GITHUB_REPO_NAME=thoughts
GITHUB_TODO_PATH=TODO.md
GITHUB_BRANCH=main
